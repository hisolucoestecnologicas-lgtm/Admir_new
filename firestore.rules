rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin profiles and credentials
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && isAdmin();
    }

    // Encrypted / Chunks private documents - strictly restricted
    match /private_documents/{docId} {
      allow read, write: if isSignedIn() && isAdmin();
    }
  }
}

